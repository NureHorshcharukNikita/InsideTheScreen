    pointAt: battle_strength
    pointerSide: 0
  - moment: 0
    turn: 2
    tries: 0
    dialogue: {fileID: 0}
    speaker: 1
    text: "And watch the wolf. Games like this always show you what the enemy does next."
    waitForClick: 1
    pointAt: enemy_intent
    pointerSide: 1
  - moment: 0
    turn: 2
    tries: 0
    dialogue: {fileID: 0}
    speaker: 0
    text: "That's... actually helpful."
    waitForClick: 0
    pointAt: 
    pointerSide: 0
  - moment: 0
    turn: 2
    tries: 1
    dialogue: {fileID: 0}
    speaker: 1
    text: "Again. Slower this time. I'm right here."
    waitForClick: 1
    pointAt: 
    pointerSide: 0
  - moment: 2
    turn: 2
    tries: 0
    dialogue: {fileID: 0}
    speaker: 1
    text: "Like that. Keep going."
    waitForClick: 0
    pointAt: 
    pointerSide: 0
  - moment: 3
    turn: 2
    tries: 0
    dialogue: {fileID: 0}
    speaker: 1
    text: "Out of strength? End your turn. Then it's the wolf's move."
    waitForClick: 1
    pointAt: battle_end_turn
    pointerSide: 0
  - moment: 1
    turn: 2
    tries: 0
    dialogue: {fileID: 0}
    speaker: 1
    text: "Your strength comes back a little every turn."
    waitForClick: 0
