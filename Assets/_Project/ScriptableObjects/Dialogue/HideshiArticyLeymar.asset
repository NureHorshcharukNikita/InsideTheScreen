  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyLeymar
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 0, speakerName: Haru, text: "Is this... Leymar?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Looks like it.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Dad... those aren't people...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Not all of them, it seems.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "They look... different.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Yes. Like beastfolk, or something like that.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "They aren't even looking at us, as if we live here too.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "They don't seem to care that we're here.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Maybe travelers aren't unusual here.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "I've never seen anything like this.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "It makes me uneasy.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "It's all right. Just don't let these people see how uneasy you are.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Wait...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "What?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "There's a tower in the center. That old man must be Eldon, the one the trader mentioned.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "We need to go there. Let's try talking to him.", nextLineIndex: -1, endDialogueAfterLine: 1}
