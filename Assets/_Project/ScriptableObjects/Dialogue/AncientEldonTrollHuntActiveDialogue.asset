  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: AncientEldonTrollHuntActiveDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: The troll still prowls near Leymar. Face it carefully; brute strength is loud, but hunger is louder.
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: Which troll?
      nextLineIndex: 1
      endDialogue: 0
      actions: []
    - text: I will return later.
      nextLineIndex: -1
      endDialogue: 1
      actions: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: Which troll?
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: The one by the southern path. Bring it down, and take what meat you can use.
    nextLineIndex: 0
    endDialogueAfterLine: 0
    actions: []
    choices: []
