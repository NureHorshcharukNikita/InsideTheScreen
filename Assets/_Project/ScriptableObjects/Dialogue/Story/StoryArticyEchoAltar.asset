%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: StoryArticyEchoAltar
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Here goes.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "The light... it's getting brighter!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "No... it's turning black!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Soul Devourer, portraitOverride: {fileID: 0}, text: "...A signal.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Soul Devourer, portraitOverride: {fileID: 0}, text: "A full soul. Two full souls. It has been so long.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Haru, get behind me!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Soul Devourer, portraitOverride: {fileID: 0}, text: "Your memories smell of reality. I will keep them. I keep everything.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Get away from him!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Soul Devourer, portraitOverride: {fileID: 0}, text: "Do not resist. You are not being lost. You are being saved. Forever.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Haru! Run!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "No! I'm not leaving you!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "The crystal... if I break it, it'll stop!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Dad!!!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Dad?..", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "No... no, no, no...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "His knife... his notebook... a piece of his watch...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 21300000, guid: 36235e70ef35c844bb0297d6a6788b0a, type: 3}, text: "Haru!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 21300000, guid: 36235e70ef35c844bb0297d6a6788b0a, type: 3}, text: "I felt the surge from Leymar. I came as fast as I could.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "It took him. Something came out of the dark and took him!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 21300000, guid: 36235e70ef35c844bb0297d6a6788b0a, type: 3}, text: "The Soul Devourer. The crystal woke it. I thought it was only a legend...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "I broke the crystal. I thought it would stop it...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 21300000, guid: 36235e70ef35c844bb0297d6a6788b0a, type: 3}, text: "It did stop it. But the process was cut short. His soul was not taken whole.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 21300000, guid: 36235e70ef35c844bb0297d6a6788b0a, type: 3}, text: "It shattered. I saw the fragments scatter across the land.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Fragments? So he's... still out there?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 21300000, guid: 36235e70ef35c844bb0297d6a6788b0a, type: 3}, text: "Somewhere. In pieces. And the world has changed. Everything that was dangerous before will be worse now.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Krek, portraitOverride: {fileID: 0}, text: "...Haru.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Who's there?!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Krek, portraitOverride: {fileID: 0}, text: "Don't look around. I'm not out there. I'm in here.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Krek, portraitOverride: {fileID: 0}, text: "Call me Krek. I'll be with you from now on.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "What do you want?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Krek, portraitOverride: {fileID: 0}, text: "The same as you. To get him back.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Krek, portraitOverride: {fileID: 0}, text: "Every fragment of his soul is out there. Find them, and he will hear you.", nextLineIndex: -1}
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Then I'll find them. All of them. No matter where I have to go."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 2
      quest: {fileID: 11400000, guid: c66f34375861a11b4ff0464e7f5f57c7, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    choices: []
