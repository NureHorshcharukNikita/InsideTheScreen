  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: FennaTalkEars
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Where are your ears? Your real ones."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "These are my real ones."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Those little ones on the sides of your head? Can you even hear with those?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Pretty well, actually."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Then what am I thinking right now?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "That's not how ears work."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Hmph. Mine would know."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Hmph. Mine would know."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Don't look at me. Mine can't do that either."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
