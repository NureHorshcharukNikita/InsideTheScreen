  lines:
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 0}
    text: "Hey! Where's your tail?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "I... don't have one."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 0}
    text: "Did it fall off?!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "No! Where I'm from, people just don't have tails."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 0}
    text: "That's so sad."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 0}
    text: "I'm Fenna! When I grow up, I'll keep watch like Papa. All night!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
