  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: BrannocTalkFamily
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "Tell me? She came home with a list of questions about you. She wanted me to ask them for her."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Go on, then."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "I told her a man's tail is his own business. Even when he hasn't got one."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "She's been making you one out of grass, by the way. If she hasn't shown you yet, act surprised."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
