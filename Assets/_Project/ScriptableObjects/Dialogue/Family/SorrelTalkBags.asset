  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: SorrelTalkBags
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "I thought I knew that smell. It still smells of his forge."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Then he likes you more than he lets on. Garr doesn't part with his things for just anyone."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Don't tell him I said so."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
