  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: SorrelTalkNews
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Garr's forge kept half the village up last night. Fenna says it sounded like a dragon snoring. Brannoc says dragons don't snore. They argued until breakfast."
    conditions:
    - type: 0
      storyFlag: a1_crystal_forging
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    - type: 0
      storyFlag: a1_crystal_charged
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Fenna's telling everyone a boy with no tail chased off a wolf. By tomorrow it'll be three wolves and a bear."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: c1301b1fd751b1f2854ea3b6ca647c95, type: 2}
      questStatus: 2
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Everyone's talking about the trader's hand. Garr says it's nothing. Garr says that about his own burns, too."
    conditions:
    - type: 0
      storyFlag: a1_trader_met_bitten
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "The hens have stopped laying. Brannoc says it's the cold. Fenna says it's because she sang to them."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
