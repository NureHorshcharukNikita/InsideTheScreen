%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: FoxFamilyMeeting
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Good morning. I'm Hideshi, and this is my son, Haru. We arrived last night."
    conditions: 
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Um... good morning. I'm Haru. We arrived last night - my dad and me."
    conditions: 
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Oh! Good morning! Then you must be the two Garr found asleep in his barn."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Half the village heard him this morning."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "We didn't know it was anyone's. It looked empty."
    conditions: 
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "We apologised. He was kinder about it than he had to be."
    conditions: 
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Dad and I thought nobody used it. Garr let it go, though."
    conditions: 
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "That's Garr. He roars like his forge, then cools down just as fast."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "He has a good heart. He just keeps it somewhere under his anvil."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "I'm Sorrel. My husband Brannoc keeps watch over the village at night - you may have seen him."
    conditions:
    - type: 0
      storyFlag: a1_met_brannoc
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "I'm Sorrel. And you've already met my husband, Brannoc - he told me."
    conditions:
    - type: 0
      storyFlag: a1_met_brannoc
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "And this is our daughter, Fenna. ...Fenna? Where did you go?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "A minute ago she wanted to know everything about the new boy. Now look at her. Not a word."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Go on, sweetheart. Say hello."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...H-hello."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: "Hi, Fenna. I like the flower in your hair."
      nextLineIndex: 16
      endDialogue: 0
      actions: []
    - text: "Hi. It's alright, I don't bite."
      nextLineIndex: 18
      endDialogue: 0
      actions: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...It's a moon daisy. Mama put it there."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...You can't have it."
    conditions: []
    nextLineIndex: 20
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...Papa says everybody bites if you pull their tail."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Then I'll keep away from tails."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...Can I ask you something?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Sure. Anything."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Where's your tail?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Fenna!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "I... don't have one."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "But you're not old!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "What does being old have to do with it?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Garr doesn't have a tail. Eldon doesn't have a tail. They're old. So theirs fell off."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Humans don't have tails, sweetheart. Not Garr, not Eldon, and not Haru. We've talked about this."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...I thought Garr was just very, very old."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "I'll be sure to tell him that."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Please don't."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Where I'm from, nobody has a tail. Not even a little one."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Nobody?! That's so sad."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Then what do you wag when you're happy?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: "I smile, I guess."
      nextLineIndex: 36
      endDialogue: 0
      actions: []
    - text: "Nothing. I just say I'm happy."
      nextLineIndex: 37
      endDialogue: 0
      actions: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Just your face? That's not nearly enough!"
    conditions: []
    nextLineIndex: 38
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "With words? That sounds like so much work!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Does your papa smile too?"
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Dad? Hardly ever."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "I'm smiling right now."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "...No you're not."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "And what do you curl up in when it's cold? And how does anyone know when you're cross? And-"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "That's enough for one morning, little one. Let the boy breathe."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "But I have a hundred more!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Then they'll keep until tomorrow."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Don't mind her, Haru. Strangers don't often stay in Leymar long enough to be asked anything."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "If you get hungry, the bushes by Eldon's tower don't belong to anyone. Help yourself."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Thank you. We'll keep that in mind."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Bye, Haru! Come back soon! I'm saving my questions!"
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_met_fox_family
      silent: 1
      shop: {fileID: 0}
      enemy: {fileID: 0}
      encounterId: 
      card: {fileID: 0}
      count: 1
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Bye, Haru! Bye, Haru's papa! I'm saving my questions for both of you!"
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_met_fox_family
      silent: 1
      shop: {fileID: 0}
      enemy: {fileID: 0}
      encounterId: 
      card: {fileID: 0}
      count: 1
    choices: []
  noTalkTopics: 0
