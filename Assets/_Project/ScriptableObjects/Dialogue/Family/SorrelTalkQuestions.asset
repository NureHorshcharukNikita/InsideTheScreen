  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: SorrelTalkQuestions
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Oh, she's only getting started. She's been practising them on her father all morning."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "How many has she got?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "At breakfast it was forty. By supper it'll be a hundred."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Be patient with her. Most strangers in Leymar are traders, and traders never stay long enough to answer anything."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "You and your father are the first new faces she's had in a long while."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
