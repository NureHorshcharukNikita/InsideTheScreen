  lines:
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Garr's forge was roaring all night! I think he's making a sword. A huge one. ...Or a spoon."
    conditions:
    - type: 0
      storyFlag: a1_crystal_forging
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    - type: 0
      storyFlag: a1_crystal_charged
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Papa says I can go as far as the little bridge now! Not the big one. The little one."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: c1301b1fd751b1f2854ea3b6ca647c95, type: 2}
      questStatus: 2
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "Is it true the trader got bitten? Did he cry? I'd cry. A little."
    conditions:
    - type: 0
      storyFlag: a1_trader_met_bitten
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Fenna
    portraitOverride: {fileID: 21300000, guid: bc0d44b9ac2a42eb911f06f6a6426594, type: 3}
    text: "I found a beetle! It's blue! ...It got away. It's a very fast beetle."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
