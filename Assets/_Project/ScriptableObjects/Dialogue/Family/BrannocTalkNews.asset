  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: BrannocTalkNews
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "Garr's forge burned all night. First time in years I've seen it lit past dark. Whatever he's making for Eldon, he isn't whistling while he does it."
    conditions:
    - type: 0
      storyFlag: a1_crystal_forging
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    - type: 0
      storyFlag: a1_crystal_charged
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "Quiet nights. I walked the south road twice and heard nothing but frogs. I'd forgotten what that sounds like."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: c1301b1fd751b1f2854ea3b6ca647c95, type: 2}
      questStatus: 2
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "I'll look in on the trader tonight. A man alone by a fire is easy to find, and not only for friends."
    conditions:
    - type: 0
      storyFlag: a1_trader_met_bitten
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "The lamp by the well keeps going out. Third night running. Either the wick's bad, or someone's been blowing it out. My money's on someone medium-sized."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
