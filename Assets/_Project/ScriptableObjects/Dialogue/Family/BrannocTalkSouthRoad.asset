  lines:
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "All night. The tracks are fresh. Whatever it is, it isn't moving on."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "We'll be careful."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "Careful isn't enough out there. Stay together."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
