  m_Name: BrannocTalkNight
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "When I can. Every night I walk the village twice. Once when the lamps are lit, once when they go out."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "What are you watching for?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "Anything that doesn't belong here."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Brannoc
    portraitOverride: {fileID: 0}
    text: "The first night, that was you two. No offence."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 0}
