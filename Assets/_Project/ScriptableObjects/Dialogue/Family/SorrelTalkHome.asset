--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: SorrelTalkHome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "You're welcome, dear. May I ask you something in return? You don't have to answer."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Where is home for you? You don't talk like anyone from around here."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: "Far away. Very far."
      nextLineIndex: 2
      endDialogue: 0
      actions: []
    - text: "Honestly? I don't know how to explain it."
      nextLineIndex: 3
      endDialogue: 0
      actions: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Far away, then. Brannoc says the same about where he grew up, and then not another word."
    conditions: []
    nextLineIndex: 4
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Then don't. Some things are hard to put into words."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "We're still working out the way back. But we'll find it."
    conditions:
    - type: 5
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 0}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Wherever it is, I hope it's waiting for you."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Sorrel
    portraitOverride: {fileID: 21300000, guid: 8b359da9ea5144e4acb5165c208d8d1e, type: 3}
    text: "Until then, you have friends in Leymar. Just knock before you move into someone's barn next time."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  noTalkTopics: 0
