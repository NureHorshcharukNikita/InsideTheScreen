  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: AncientEldonReturnDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: You have returned. Good. Leymar changes its questions when no one is watching.
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: What do you know about Leymar?
      nextLineIndex: 1
      endDialogue: 0
      actions: []
    - text: Goodbye.
      nextLineIndex: -1
      endDialogue: 1
      actions: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: What do you know about Leymar?
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: Leymar is not lost. It hides from those who arrive certain they already understand it.
    nextLineIndex: 0
    endDialogueAfterLine: 0
    actions: []
    choices: []
