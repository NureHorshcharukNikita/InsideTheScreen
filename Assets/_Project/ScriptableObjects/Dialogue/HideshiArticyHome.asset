%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyHome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Hideshi, text: "Hey, I'm home.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Oh, Dad. You're late today.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "I am. But I brought something interesting. Look!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "A disc? It's old... scratched... and doesn't even have a case.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "A real rarity. They say only a handful of copies are left.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "It doesn't even have a title.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "What did you expect from something this old?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Maybe that's intentional. Let's boot it up and see.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Can we even run it?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "I've got an old console. Remember?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Seriously? It still works?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Don't joke. Those things are built to last. You'll see.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "It should work just fine!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "All right... let's try it.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Here, take the disc. I'll get the console!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Be careful...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "I know what I'm doing.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Ahem... Right... This goes here...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Done! Put the disc in!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "It actually worked... There's even a menu...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Told you.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "But it all looks so strange... almost like...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Whoa... what's that noise?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Step away from the screen. I'll fix...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "What's happening?! It's pulling you in!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Dad!!", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Take my hand!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, text: "Haru! Stay back!", nextLineIndex: -1, endDialogueAfterLine: 1}
