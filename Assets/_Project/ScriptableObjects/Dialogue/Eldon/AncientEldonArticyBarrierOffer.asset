  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: AncientEldonArticyBarrierOffer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 0}, text: "Before you leave the village, one more thing.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "What is it?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 0}, text: "Leymar is protected by a barrier. You cannot see it, but it keeps the worst of the forest away.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 0}, text: "Since you arrived, it has been growing thin.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Because of us?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Ancient Eldon, portraitOverride: {fileID: 0}, text: "Because the world is restless. I need crystal dust from the old well to strengthen it.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Crystal dust. How much?", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: "Three handfuls. Bring them to me when you can."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 1
      quest: {fileID: 11400000, guid: aa6089a987eb4f121e2c95bf964871c0, type: 2}
