  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: AncientEldonTraderBitten
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "We found the trader. A wolf bit his hand."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: "A wolf? That close to the village... How terrible."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "The same one that followed us out of the forest."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: "The wilds grow bolder every night. That is what the barrier is for - to keep them out there."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: "See to his hand, and bring me that dust. The sooner the barrier holds, the safer we all are."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
