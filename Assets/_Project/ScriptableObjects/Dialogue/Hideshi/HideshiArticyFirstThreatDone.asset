  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyFirstThreatDone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "We did it... We actually beat them.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "You did. I barely had to do anything.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "My hands are still shaking.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "That's normal. Mine shook too, when that wolf jumped at me.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "They behave like living creatures... but something in them is broken. As if someone twisted them.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Twisted by what?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "I don't know yet. Let's finish the crystal first. Maybe then we'll find out.", nextLineIndex: -1, endDialogueAfterLine: 1}
