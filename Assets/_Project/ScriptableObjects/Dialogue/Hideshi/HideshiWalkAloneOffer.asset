  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiWalkAloneOffer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Haru. Remember the trader by the fire?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "The strange one? He showed us the way here."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "He did. And he's out there all alone, with wolves around."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Go and see if he needs a hand. Alone, this time."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Alone? Through the forest?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Just down the south road. You know it already - and I won't always be right next to you."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: "I'll go."
      nextLineIndex: 6
      endDialogue: 0
      actions: []
    - text: "Not now."
      nextLineIndex: -1
      endDialogue: 1
      actions:
      - type: 4
        quest: {fileID: 0}
        storyFlag: a1_walk_alone_declined
        silent: 1
        shop: {fileID: 0}
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Okay. Down the south road."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "I'll be right here. If anything feels wrong, turn around and come back."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: hideshi_stays_behind
      silent: 1
      shop: {fileID: 0}
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_hideshi_in_village
      silent: 1
      shop: {fileID: 0}
