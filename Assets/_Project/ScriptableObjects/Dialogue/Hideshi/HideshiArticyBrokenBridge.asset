  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyBrokenBridge
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "The bridge... it's broken.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Half of it is just gone.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "What could do something like that?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Not the river. Look, the boards are snapped, not rotten.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "So something broke it?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Or someone. Either way, we can't cross here.", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Let's head for the smoke instead. Whoever lit that fire might know another way across."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 6b17c5a25c203580afb8005c062b0149, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Right. Let's go."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 6b17c5a25c203580afb8005c062b0149, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
