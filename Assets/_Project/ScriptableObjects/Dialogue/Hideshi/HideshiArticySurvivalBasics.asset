  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticySurvivalBasics
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Haru, wait a moment.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "What is it?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Garr said it's grown dangerous beyond the village. I believe him. That wolf was only the beginning.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "So what, we just stay here?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "No. But before we go out there, I want to be sure you can take care of yourself.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Have you noticed? Everything here turns into cards. Berries, stones, even a stick.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Yeah... just like in a game.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Then let's play by its rules. Gather whatever you can find around the village and see what cards you get.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "And then?", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Then we'll know what we're working with. Go on, I'll be right here."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 1
      quest: {fileID: 11400000, guid: 92a4ffbd6dd3a0cbef69334e4c2e035b, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    choices: []
