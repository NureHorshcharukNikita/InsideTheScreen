%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiLeymarExitClosed
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Haru, wait.", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "We came here to find Eldon. The trader said he lives in the tower."
    conditions:
    - type: 0
      storyFlag: met_ancient_eldon
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "It's the middle of the night. Eldon told us to settle in and come back in the morning."
    conditions:
    - type: 0
      storyFlag: met_ancient_eldon
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Let's find somewhere to sleep first."
    conditions:
    - type: 0
      storyFlag: met_ancient_eldon
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Where does this road go?"
    conditions:
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Out of Leymar. And we have no reason to go out there yet."
    conditions:
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Eldon hasn't told us what to look for. Until he does, there's nothing for us out there."
    conditions:
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "And until then?"
    conditions:
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Until then, we stay in the village. Help where we can, talk to people. Someone here may know more than they let on."
    conditions:
    - type: 0
      storyFlag: a1_spent_night
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
