  lines:
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "The trader's camp is down the south road. I'll be right here."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 74e9d4fa792242b798924285e6984110, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "The trader lost his pack somewhere in the woods west of his camp."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 80a8edc72b664963b66869b9fc91c9ab, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Then find it - carefully. I'm not going anywhere."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 80a8edc72b664963b66869b9fc91c9ab, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Go on. I'll be right here."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
