%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyWolf
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Look, Dad... there's a path.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Great. Let's follow it. Better than standing here.", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "There are tracks on the ground...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Stay close.", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Did you hear that crack?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Something's rustling in the bushes ahead.", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "It's... a wolf!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Keep your distance and do as I say.", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "It's charging!", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Get back!", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Go away!", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "It's backing off...", nextLineIndex: -1, endDialogueAfterLine: 1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "That wolf was too thin... and wild. It looks like it hasn't seen anyone in a long time.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "It could have killed us...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Dad... are you hurt?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "No. I'm fine. But this place is dangerous.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "I hope there's more than wolves living here.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Look. Smoke, over the trees.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Maybe there are people there?", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Let's get there and find out."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 2
      quest: {fileID: 11400000, guid: 3675c722159f7ed3a5b6e71a669d5c1a, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    - type: 1
      quest: {fileID: 11400000, guid: 6b17c5a25c203580afb8005c062b0149, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    choices: []
