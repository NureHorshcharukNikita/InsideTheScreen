--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiTalkWhatNow
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Gather what you can by the apple bushes west of the tower. Berries, an apple, a stick and a stone."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 92a4ffbd6dd3a0cbef69334e4c2e035b, type: 2}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_basic_resources_gathered
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Eldon's dust. Say the word, and we'll go and look for it."
    conditions:
    - type: 0
      storyFlag: a1_dad_ready_to_go
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Show me what you found, then we'll see."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 92a4ffbd6dd3a0cbef69334e4c2e035b, type: 2}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_basic_resources_gathered
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "The trader's hand needs seeing to. Garr will know what helps."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 10817b4f8a724cec8df0f3e6478bd33b, type: 2}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_salve_recipe
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Leaves, bark, a red flower and berries, by the bushes west of the tower. Then Garr's bench."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 10817b4f8a724cec8df0f3e6478bd33b, type: 2}
      questStatus: 1
      invert: 0
    - type: 2
      storyFlag: 
      quest: {fileID: 11400000, guid: 10817b4f8a724cec8df0f3e6478bd33b, type: 2}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Take the herbs to the trader by the east gate."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 10817b4f8a724cec8df0f3e6478bd33b, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "The dust from the crossroads stone. The wind has scattered it around the village. Look for where it glitters."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: aa6089a987eb4f121e2c95bf964871c0, type: 2}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_crystal_dust_collected
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "That's enough dust. Let's take it to Eldon."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: aa6089a987eb4f121e2c95bf964871c0, type: 2}
      questStatus: 1
      invert: 0
    - type: 0
      storyFlag: a1_crystal_dust_collected
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Eldon has something to tell us. Let's hear him out."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: aa6089a987eb4f121e2c95bf964871c0, type: 2}
      questStatus: 2
      invert: 0
    - type: 0
      storyFlag: eldon_echo_crystal_discussed
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Garr should see Eldon's recipe. Let's go to the forge."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: a8fcd588209c1818a81368b066c1b279, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Garr wants the stone with the crystal vein first. Under the old roots at the forest edge."
    conditions:
    - type: 1
      storyFlag: 
      quest: {fileID: 11400000, guid: 93ac9dd922f597cff585c5b9b8c3670f, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Nothing pressing. Let's look around and see who needs a hand."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
