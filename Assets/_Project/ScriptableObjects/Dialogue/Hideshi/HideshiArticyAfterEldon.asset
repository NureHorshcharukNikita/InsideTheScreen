MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyAfterEldon
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 0, speakerName: Haru, text: "He's strange too, just like the others...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Strange or not, he seems to know more than the others.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "That's why we'll have to listen to him.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Do you trust him?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Not entirely.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Then why are we staying?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Because we don't have another choice.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "I don't like this place.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Neither do I. But right now, we need to get through the night.", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Let's find somewhere to sleep first."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 1
      quest: {fileID: 11400000, guid: d9aac8c1da9447e8ae1458d02b3acfaa, type: 2}
      storyFlag:
      silent: 0
      shop: {fileID: 0}
    choices: []
