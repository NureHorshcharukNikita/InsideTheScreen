  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyIdle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Stay close to the village when it gets dark.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "I know, Dad.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "And don't wander into other people's barns.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Very funny.", nextLineIndex: -1, endDialogueAfterLine: 1}
