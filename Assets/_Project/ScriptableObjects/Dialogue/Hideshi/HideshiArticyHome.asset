--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiArticyHome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "Oh, Dad. You're late today.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "I am. But I brought something interesting. Look!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "A disc? It's old... scratched... and doesn't even have a case.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "A real rarity. They say only a handful of copies are left.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "It doesn't even have a title.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "What did you expect from something this old?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Maybe that's intentional. Let's boot it up and see.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "Can we even run it?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "I've got an old console. Remember?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "Seriously? It still works?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Don't joke. Those things are built to last. You'll see.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "It should work just fine!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "All right... let's try it.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Here, take the disc. I'll get the console!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Haru, portraitOverride: {fileID: 21300000, guid: f2881b5c4e5572e43b739c7b2f89f654, type: 3}, text: "Be careful...", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "I know what I'm doing.", nextLineIndex: -1, endDialogueAfterLine: 1}
