  lines:
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "I'm back!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "In one piece. Good. Did the trader need anything?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Something tore his pack off his cart and dragged it into the woods. I found it."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "On your own? In the forest?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "It's just the woods, Dad."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "...Yes. It is."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 0}
    text: "Come on. Let's see what else this village needs from us."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
