  lines:
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Dad, I've looked everywhere. Two handfuls, and nothing else glitters."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Then the third isn't lying around to be found."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Maybe Eldon can tell us where to look. Let's go and ask him."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
