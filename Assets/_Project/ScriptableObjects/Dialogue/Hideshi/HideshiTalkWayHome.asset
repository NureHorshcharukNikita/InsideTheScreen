  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: HideshiTalkWayHome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "We will.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "You say that like you know.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "I don't. But we got in somehow, so there has to be a way out.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Eldon's dreams, the barrier, that light in the stone... It's a thread. We pull on it until something gives.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Dad... the people on the news. The ones who vanished from their homes.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "I've thought about them too.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "If they ended up here, then we're not the first. And maybe one of them found the way back.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "And if no one did?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Hideshi, portraitOverride: {fileID: 0}, text: "Then we'll be the first.", nextLineIndex: -1, endDialogueAfterLine: 1}
