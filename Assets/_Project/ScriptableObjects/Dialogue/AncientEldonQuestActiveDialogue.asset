  lines:
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: The chest already listens for you. Follow its blue hum, and do not mistake silence for safety.
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: What should I look for?
      nextLineIndex: 1
      endDialogue: 0
      actions: []
    - text: I will return later.
      nextLineIndex: -1
      endDialogue: 1
      actions: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: What should I look for?
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Ancient Eldon
    portraitOverride: {fileID: 0}
    text: A lock that is warm, a light that breathes, and a sound that does not belong to metal.
    nextLineIndex: 0
    endDialogueAfterLine: 0
    actions: []
    choices: []
