  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: OccultistConfrontation
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Occultist
    portraitOverride: {fileID: 0}
    text: "Another seeker comes to the altar..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Occultist
    portraitOverride: {fileID: 0}
    text: "And you carry a voice in a stone. I can hear it singing."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Step aside. We only need the pedestal."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Occultist
    portraitOverride: {fileID: 0}
    text: "The altar sleeps for a reason, child. Wake it, and something will answer that you did not call."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "We'll take that chance."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Occultist
    portraitOverride: {fileID: 0}
    text: "I swore to keep it sleeping. The voice in the dark gave me the strength to keep that vow."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Occultist
    portraitOverride: {fileID: 0}
    text: "Leave. Or stay here forever, like all the others."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices:
    - text: "Step back."
      nextLineIndex: -1
      endDialogue: 1
      actions: []
    - text: "We're not leaving."
      nextLineIndex: -1
      endDialogue: 1
