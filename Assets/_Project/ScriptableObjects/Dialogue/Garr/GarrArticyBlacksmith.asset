%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: GarrArticyBlacksmith
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Not now, lad. The iron's hot, and it won't wait.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "The whole village has been at my door since sunrise.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Eldon sent us. He says only you can forge this.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "...Eldon. Of course he did. It's always easier for him to send someone else.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "He said to tell you he asked.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Show me.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Here.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "...Hm.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "I know this design.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "I swore I'd never forge it again.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "It's our only way home.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "...Fine. But this is the last time.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Can you start right away?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Not yet. I'll need materials.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "What kind of materials?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Iron... not ordinary iron... and a shard... and resin... yes, that's what I need!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Here. Take the list.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Bring me everything, then come back.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Oh... and one more thing.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "What?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "It's grown more dangerous beyond the village. Be careful.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "So where do we even start?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "With the shard. Beneath the old roots at the forest edge lies a stone with a crystal vein. Dig it up and bring it to me.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "And the resin? The iron?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "One thing at a time. The stone first.", nextLineIndex: -1}
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Fair enough. We'll start with the stone."
    nextLineIndex: -1
    actions:
    - type: 2
      quest: {fileID: 11400000, guid: a8fcd588209c1818a81368b066c1b279, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    - type: 1
      quest: {fileID: 11400000, guid: c5a7aeb7b3e7722e75dad7c6b4773d11, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    - type: 1
      quest: {fileID: 11400000, guid: 93ac9dd922f597cff585c5b9b8c3670f, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    choices: []
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Hold on. You'll be hauling stone, resin and iron. Your pockets won't hold that.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Here. An old pack and a belt with pouches. They'll make the gathering easier.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Thank you, Garr.", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Garr Steelclad
    text: "Don't thank me. Bring them back in one piece. And yourselves with them."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_bags_received
      silent: 1
      shop: {fileID: 0}
    choices: []
