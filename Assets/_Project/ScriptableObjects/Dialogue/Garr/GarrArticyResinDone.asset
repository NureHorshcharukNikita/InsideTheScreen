  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: GarrArticyResinDone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "Good resin. Smells like the forest before everything went wrong.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "What's the last thing?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "Cold iron. Not the kind you dig up near the village.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "There's a cave past the riverbank. The iron there stays cold even in summer.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Let me guess. Something lives in that cave.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "An ogre. Big, angry, and very attached to its rocks.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Great...", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Bring me three pieces of that iron, and I'll make your crystal."
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 2
      quest: {fileID: 11400000, guid: 9dfe884defda724adb964098ee19c64c, type: 2}
