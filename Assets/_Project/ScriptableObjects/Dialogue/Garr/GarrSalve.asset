--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: GarrSalve
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Not now, lad. The iron's hot, and it won't wait."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "It's the trader on the south road. A wolf bit his hand."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "...Deep?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Deep enough. He won't stop grumbling."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Then he'll live. But a bite left open goes bad."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "My hands are full right now. Bring me what it takes, and I'll tell you what to do next."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "What does it take?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Leaves, tree bark, a red flower and a few berries."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Where do I find all that?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Berries grow low in the grass around the village. The rest grows by the broken bridge - you'll find it all there."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_salve_ingredients
      silent: 1
      shop: {fileID: 0}
      enemy: {fileID: 0}
      encounterId: 
      card: {fileID: 0}
      count: 1
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "What broken bridge?"
    conditions:
    - type: 0
      storyFlag: a1_broken_bridge
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    - type: 0
      storyFlag: a1_broken_bridge_seen_alone
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Down south, past the trader's camp. The old bridge over the river - broken for years."
    conditions:
    - type: 0
      storyFlag: a1_broken_bridge
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    - type: 0
      storyFlag: a1_broken_bridge_seen_alone
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
