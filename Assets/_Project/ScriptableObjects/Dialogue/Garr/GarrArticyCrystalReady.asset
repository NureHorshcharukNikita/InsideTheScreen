  m_Name: GarrArticyCrystalReady
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "There you are.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "Here. Your crystal.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "It's... heavier than it looks.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "And colder. It's not quite metal and not quite stone. I've never made anything like it.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Thank you, Garr. Really.", nextLineIndex: -1}
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Take it to Eldon. And whatever he tells you to do with it... be careful."
    nextLineIndex: -1
    endDialogueAfterLine: 1
