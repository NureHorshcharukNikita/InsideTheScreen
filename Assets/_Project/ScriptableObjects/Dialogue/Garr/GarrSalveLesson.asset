%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: GarrSalveLesson
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "We've got everything. Leaves, bark, a red flower and the berries."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Let's see them, then."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Hm. Fresh. That'll do."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "...He didn't even blink."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Put it away. Keep yours for your own salve - I'll show you on mine. Come, watch."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "A bite wants two things. Something to draw the bad out, and something to keep the dirt off."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "The flower and the berries draw it out. They go in first. Crushed."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Like jam. No lumps - a lump in a wound is a stone in a boot."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Now the leaves. Rub them between your palms till they go soft and dark. Tear them and they're no good."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Soft as cloth. Paste in the middle, fold it over like a letter, and bind it with thin strips of bark."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "There. It goes on the bite and stays on till it itches. Itching means it's working."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "That's all there is to it. Flower and berries, then the leaf, then the bark."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "...Hm. You didn't look away once. That's rarer than you'd think."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Only when he wants to."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Dad!"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "This one's mine. Yours you make yourself - the bench is yours till you're done."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Done already? ...Hm. Quick hands."
    conditions:
    - type: 3
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 11400000, guid: 442fed74c6c741a38916a82c41291104, type: 2}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Smells right, too. Now off with you, before that bite of his goes bad."
    conditions:
    - type: 3
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
      card: {fileID: 11400000, guid: 442fed74c6c741a38916a82c41291104, type: 2}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Take your time. The bench will keep."
    conditions:
    - type: 3
      storyFlag: 
      quest: {fileID: 0}
      questStatus: 1
      invert: 1
      card: {fileID: 11400000, guid: 442fed74c6c741a38916a82c41291104, type: 2}
      count: 1
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
