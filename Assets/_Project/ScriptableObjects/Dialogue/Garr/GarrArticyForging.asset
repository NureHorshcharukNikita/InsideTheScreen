  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: GarrArticyForging
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "You actually did it. You beat the ogre."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "It wasn't easy."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "It never is."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Shard, resin, cold iron... Yes. That's everything."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "How long will it take?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Come back tomorrow."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_crystal_forging
      silent: 1
      shop: {fileID: 0}
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "And sleep in my barn tonight. With permission, this time."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "We'll take it. Thank you, Garr."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
