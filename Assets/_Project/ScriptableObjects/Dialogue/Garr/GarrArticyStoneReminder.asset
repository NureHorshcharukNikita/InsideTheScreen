  lines:
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "The stone with the crystal vein. Beneath the old roots at the forest edge. Did you get lost?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "We're working on it.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, portraitOverride: {fileID: 0}, text: "Work faster.", nextLineIndex: -1, endDialogueAfterLine: 1}
