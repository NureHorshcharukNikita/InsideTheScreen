%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: GarrArticyNextMorning
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Hey! What are you doing here?!", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Strangers in my barn?", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Sorry, we didn't know it was yours.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "We thought the place was abandoned.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "We just needed somewhere to spend the night.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Abandoned, you say... Ha.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "People don't even remember I live here anymore.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Ah... I see.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "You don't look like locals.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "We're not...", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "I'm Garr Steelclad.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "The village blacksmith.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "My name is Hideshi.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "And this is my son, Haru.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "We're from another world, if you can believe that.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "We met Ancient Eldon yesterday.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "He let us stay in Leymar.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "It was late, so we didn't dare disturb anyone.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Sorry if we did the wrong thing.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Hideshi... Haru... Strange names. Haven't even heard anything like them from the northern nomads.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Strange? They're ordinary names... Everything here is strange to us.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Fair enough. The world is full of strange things these days.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "You've already spent the night, so no harm done.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "But don't go barging into places again. Folks here are friendly but wary. And strangers are rarer than good steel.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Understood. Thanks for being reasonable.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "All right. Since you're here, go see Eldon. He's already waiting for you. He probably knows what you're after.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Garr Steelclad, text: "Now clear out of my barn. I've got work to do. If you need anything repaired, the forge is by the well.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Hideshi, portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}, text: "Well, that went better than it could have.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, text: "Yeah... we got lucky.", nextLineIndex: -1}
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Let's go to the tower. It's time!"
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 4
      quest: {fileID: 0}
      storyFlag: a1_met_garr
      silent: 1
      shop: {fileID: 0}
    choices: []
