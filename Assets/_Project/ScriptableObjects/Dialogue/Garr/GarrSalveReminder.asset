  m_Name: GarrSalveReminder
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Well? Take it to him before that bite goes bad."
    conditions:
    - type: 2
      storyFlag: 
      quest: {fileID: 11400000, guid: 10817b4f8a724cec8df0f3e6478bd33b, type: 2}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "You know how now. Flower and berries first, then the leaf, then the bark."
    conditions:
    - type: 0
      storyFlag: a1_salve_recipe
      quest: {fileID: 0}
      questStatus: 1
      invert: 0
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 0}
    text: "Berries from the grass around the village; leaves, bark and a red flower by the broken bridge. Bring them here, and I'll tell you what's next."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions: []
    choices: []
