  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Got it all? Leaves, bark, the flower, berries... Good."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Garr Steelclad
    portraitOverride: {fileID: 21300000, guid: e6d7c9f5a7a493346804b4ce95740d1b, type: 3}
    text: "Where's your father? Fetch him. I'll show it once, and I'd rather two of you remembered it."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "I'll get him."
