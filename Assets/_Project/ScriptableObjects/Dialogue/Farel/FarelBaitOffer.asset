  lines:
  - speakerSide: 1
    speakerName: Farel Wanderer
    portraitOverride: {fileID: 0}
    text: "With my net back, the fish are coming back too. But they won't bite on bread crumbs."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "What do they bite on?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Farel Wanderer
    portraitOverride: {fileID: 0}
    text: "Meat. Boar is best, wolf will do. Two pieces, and I'll share my herbs with you - the good ones, from the riverbank."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Hideshi
    portraitOverride: {fileID: 21300000, guid: 1d68cf1441823f4438d8af9c5ba43460, type: 3}
    text: "Boar meat. Noted."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
