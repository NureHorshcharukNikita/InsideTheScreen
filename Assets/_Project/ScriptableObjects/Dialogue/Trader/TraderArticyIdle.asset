  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: TraderArticyIdle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - {speakerSide: 1, speakerName: Trader, portraitOverride: {fileID: 0}, text: "Still here? The road to Leymar is right there. Straight ahead, don't turn off.", nextLineIndex: -1}
  - {speakerSide: 0, speakerName: Haru, portraitOverride: {fileID: 0}, text: "Why don't you come with us?", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Trader, portraitOverride: {fileID: 0}, text: "Me? In Leymar they look at me as if I were one of the wolves now.", nextLineIndex: -1}
  - {speakerSide: 1, speakerName: Trader, portraitOverride: {fileID: 0}, text: "No. The forest is my home. Whatever is left of it.", nextLineIndex: -1, endDialogueAfterLine: 1}
