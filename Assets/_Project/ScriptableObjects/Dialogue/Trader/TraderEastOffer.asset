  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: TraderEastOffer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "That horn is half carved already. A pity the man who's meant to buy it never came."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "The lord in the east?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "His courier. Every new moon he crosses the big bridge on the eastern road, buys what I have and goes back."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Not this time. Not last time either."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "I'd go and look, but..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "...You don't leave your fire."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "You're learning. Follow the eastern road past the river, to the big bridge. Tell me what you find there."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 1
      quest: {fileID: 11400000, guid: fa4dbdc35fa942d8b4c966526e620c99, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    choices: []
