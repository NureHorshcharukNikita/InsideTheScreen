  lines:
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "From Eldon. Hang it over the fire."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Quiet. It's... quiet."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Thank you, boy. I'd forgotten what silence sounds like."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Listen. That voice - it didn't only want my fire. Last night it asked about you."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "About me?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "About a father and a son who fell out of a screen."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Keep him close, boy. Whatever is out there, it's hungry for something it doesn't have."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
