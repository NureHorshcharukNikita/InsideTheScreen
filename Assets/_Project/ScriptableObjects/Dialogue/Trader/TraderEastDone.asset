  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: TraderEastDone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "The bridge stands. But your courier won't come. I found his satchel past it - the coins were still inside."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "...Not robbers, then."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "There was a letter. \"The old altar stirs. Whoever wakes it wakes him too.\""
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Him."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Keep the coins, boy. A dead man's money buys nothing I want."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "And if you ever stand before that altar... remember whose letter you read."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 2
      quest: {fileID: 11400000, guid: fa4dbdc35fa942d8b4c966526e620c99, type: 2}
