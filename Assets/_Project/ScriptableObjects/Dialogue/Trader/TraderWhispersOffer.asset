%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d964d57d8f2a8645b731e5591055186, type: 3}
  m_Name: TraderWhispersOffer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "You again. Good. I wanted to see a face that isn't made of coals."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "Are you all right? You look like you haven't slept."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "I haven't. Not for days."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "The fire talks now, boy. At night, in the coals. A voice, asking for things."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "What things?"
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "To let it go out. To walk into the dark and listen."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "That's... not normal."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Nothing is, anymore. But the old man in the tower used to make wards for travelers. Little knots of string and bone."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 1
    speakerName: Trader
    portraitOverride: {fileID: 0}
    text: "Ask him for one. For me. I'd go myself, but..."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 0
    actions: []
    choices: []
  - speakerSide: 0
    speakerName: Haru
    portraitOverride: {fileID: 0}
    text: "...You don't leave your fire. I'll ask him."
    conditions: []
    nextLineIndex: -1
    endDialogueAfterLine: 1
    actions:
    - type: 1
      quest: {fileID: 11400000, guid: a11b6f7dcd41451c9feb65d064d189b8, type: 2}
      storyFlag: 
      silent: 0
      shop: {fileID: 0}
    choices: []
